generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model admin {
  id_admin     String         @id @db.VarChar(10)
  id_user      String         @unique @db.VarChar(30)
  users        users          @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "fk_admin_users")
  jadwal_piket jadwal_piket[]
  kartu_member kartu_member[]
  transaksi    transaksi[]
}

model check_in {
  id_checkin  String   @id @db.VarChar(10)
  id_member   String   @db.VarChar(10)
  tgl_checkin DateTime @db.Date
  jam_checkin DateTime @db.Time(6)
  member      member   @relation(fields: [id_member], references: [id_member], onDelete: NoAction, onUpdate: NoAction, map: "fk_checkin_member")
}

model cs {
  id_cs             String              @id @db.VarChar(10)
  id_user           String              @unique @db.VarChar(30)
  users             users               @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "fk_cs_users")
  jadwal_piket      jadwal_piket[]
  laporan_fasilitas laporan_fasilitas[]
}

model jadwal_piket {
  id_jadwal String   @id @db.VarChar(10)
  id_admin  String   @db.VarChar(10)
  id_cs     String   @db.VarChar(10)
  tgl_piket DateTime @db.Date
  jam_mulai DateTime @db.Time(6)
  admin     admin    @relation(fields: [id_admin], references: [id_admin], onDelete: NoAction, onUpdate: NoAction, map: "fk_jadwal_admin")
  cs        cs       @relation(fields: [id_cs], references: [id_cs], onDelete: NoAction, onUpdate: NoAction, map: "fk_jadwal_cs")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model jenis_member {
  id_jenis    String      @id @db.VarChar(10)
  nama_jenis  String      @db.VarChar(30)
  harga       Decimal     @db.Decimal(12, 2)
  durasi_hari Int
  transaksi   transaksi[]
}

model kartu_member {
  id_kartu     String @id @db.VarChar(10)
  id_admin     String @db.VarChar(10)
  id_member    String @db.VarChar(10)
  status_kartu String @db.VarChar(20)
  admin        admin  @relation(fields: [id_admin], references: [id_admin], onDelete: NoAction, onUpdate: NoAction, map: "fk_kartu_admin")
  member       member @relation(fields: [id_member], references: [id_member], onDelete: NoAction, onUpdate: NoAction, map: "fk_kartu_member")
}

model laporan_fasilitas {
  id_laporan     String   @id @db.VarChar(10)
  id_cs          String   @db.VarChar(10)
  nama_fasilitas String   @db.VarChar(100)
  tgl_laporan    DateTime @db.Date
  status_laporan String   @db.VarChar(30)
  cs             cs       @relation(fields: [id_cs], references: [id_cs], onDelete: NoAction, onUpdate: NoAction, map: "fk_laporan_cs")
}

model member {
  id_member     String         @id @db.VarChar(10)
  id_user       String         @unique @db.VarChar(20)
  jenis_kelamin String         @db.VarChar(10)
  no_hp         String         @db.VarChar(15)
  alamat        String         @db.VarChar(255)
  kota          String         @db.VarChar(100)
  check_in      check_in[]
  kartu_member  kartu_member[]
  users         users          @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "fk_member_users")
  notifikasi    notifikasi[]
  transaksi     transaksi[]
}

model notifikasi {
  id_notifikasi    String    @id @db.VarChar(25)
  id_member        String    @db.VarChar(10)
  id_transaksi     String    @db.VarChar(15)
  jenis_notifikasi String    @db.VarChar(100)
  member           member    @relation(fields: [id_member], references: [id_member], onDelete: NoAction, onUpdate: NoAction, map: "fk_notifikasi_member")
  transaksi        transaksi @relation(fields: [id_transaksi], references: [id_transaksi], onDelete: NoAction, onUpdate: NoAction, map: "fk_notifikasi_transaksi")
}

model owner {
  id_owner String @id @db.VarChar(30)
  id_user  String @unique @db.VarChar(30)
  users    users  @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "fk_owner_users")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transaksi {
  id_transaksi    String       @id @db.VarChar(15)
  id_member       String       @db.VarChar(10)
  id_jenis        String       @db.VarChar(10)
  id_admin        String       @db.VarChar(10)
  tgl_transaksi   DateTime     @db.Date
  jenis_transaksi String       @db.VarChar(30)
  metode_bayar    String       @db.VarChar(20)
  status_bayar    String       @db.VarChar(20)
  jumlah_bayar    Decimal      @db.Decimal(12, 2)
  tgl_mulai       DateTime     @db.Date
  tgl_berakhir    DateTime     @db.Date
  notifikasi      notifikasi[]
  admin           admin        @relation(fields: [id_admin], references: [id_admin], onDelete: NoAction, onUpdate: NoAction, map: "fk_transaksi_admin")
  jenis_member    jenis_member @relation(fields: [id_jenis], references: [id_jenis], onDelete: NoAction, onUpdate: NoAction, map: "fk_transaksi_jenis")
  member          member       @relation(fields: [id_member], references: [id_member], onDelete: NoAction, onUpdate: NoAction, map: "fk_transaksi_member")
}

model users {
  id_user  String  @id @db.VarChar(30)
  nama     String  @db.VarChar(255)
  username String  @db.VarChar(255)
  password String  @db.VarChar(255)
  admin    admin?
  cs       cs?
  member   member?
  owner    owner?
}
