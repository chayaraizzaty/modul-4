generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transaction {
  id_transaction Int       @id @default(autoincrement())
  id_user        Int
  nama_barang    String    @db.VarChar(100)
  jumlah         Int
  harga_satuan   Decimal   @db.Decimal(10, 2)
  tanggal        DateTime? @default(now()) @db.Timestamp(6)
  users          users     @relation(fields: [id_user], references: [id_user])
}

model userrs {
  id_user  Int    @id @default(autoincrement())
  nama     String @db.VarChar(100)
  username String @unique @db.VarChar(50)
  role     String @db.VarChar(50)
}

model users {
  id_user     Int           @id @default(autoincrement())
  nama        String        @db.VarChar(100)
  username    String        @unique @db.VarChar(50)
  role        String        @db.VarChar(50)
  transaction transaction[]
}
